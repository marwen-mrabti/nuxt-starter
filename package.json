{
  "name": "nuxt-starter",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "concurrently 'pnpm run dev:db' 'nuxt dev'",
    "dev:db": "turso dev --db-file dev.db",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "check": "pnpm run format && pnpm run lint:fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@nuxt/eslint": "1.7.1",
    "@nuxt/fonts": "0.11.4",
    "@nuxt/icon": "1.15.0",
    "@nuxt/image": "1.10.0",
    "@nuxtjs/color-mode": "3.5.2",
    "@nuxtjs/seo": "3.1.0",
    "@pinia/nuxt": "0.11.2",
    "@sentry/nuxt": "^9.46.0",
    "@tailwindcss/vite": "^4.1.17",
    "better-auth": "^1.3.34",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "import-in-the-middle": "^1.15.0",
    "nuxt": "^4.2.1",
    "nuxt-api-shield": "0.8.2",
    "nuxt-csurf": "1.6.5",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.1.17",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@iconify-json/tabler": "^1.2.23",
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.39.1",
    "eslint-plugin-format": "^1.0.2",
    "eslint-plugin-oxlint": "^1.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@vercel/nft": "^0.27.10"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sentry/cli",
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver"
    ]
  },
  "lint-staged": {
    "*": "pnpm lint"
  }
}
